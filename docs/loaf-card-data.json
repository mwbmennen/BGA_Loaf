{
  "_comment": "Transcription source for the 24 physical round cards (see docs/loaf-open-questions.md Q1). Fill in one entry per card from photos/physical inspection. Order.totals values must satisfy Q2 (average-per-player is a whole number at every listed player count). Once complete, port into Game::$ROUND_CARD_TYPES per docs/loaf-implementation-plan.md.",

  "_schema": {
    "id": "string, unique, e.g. basic_01 / advanced_01",
    "advanced": "bool - has the croissant icon on its review side",
    "order": {
      "per_player_average": "int - printed average-per-player value",
      "totals": "map of player count (2-6) to printed total for that count"
    },
    "review": {
      "success": "effect object, resolves on Happy Boss (total >= order) - see _effect_schema",
      "fail": "effect object, resolves on Angry Boss (total < order) - see _effect_schema"
    }
  },

  "_effect_schema": {
    "target": "highest_reputation | lowest_reputation | reputation_positive | reputation_negative | reputation_zero | all | null (basic cards target one of the first four; advanced 'reputation_zero'/'all' per the advanced target/effect tables)",
    "effect": "reputation | discard_choice | discard_recycle_lowest | swap_discard_lower_by_at_most | swap_discard_higher_by_at_least | end_game_bonus | end_game_malus | double_end_game_bonus | double_end_game_malus | none",
    "amount": "int or null - magnitude (reputation delta, X for swap/end-game effects); null for effects with no magnitude",
    "counts_as_two": "bool - this side counts as 2 successes/fails toward the 5-card end trigger (advanced-only 'empty effect' cards)"
  },

