{
  // option ids should be between 100 and 199
  // See https://en.doc.boardgamearena.com/Options_and_preferences:_gameoptions.json,_gamepreferences.json for more details

  "100": {
    "name": "Advanced round cards",
    "values": {
      "0": {
        "name": "Off (basic cards only)"
      },
      "1": {
        "name": "On",
        "description": "Adds the 12 advanced (croissant) round cards, with more elaborate effects. The rulebook recommends leaving this off for your first game.",
        "tmdisplay": "Advanced cards",
        "nobeginner": true
      }
    },
    "default": 0
  },

  "101": {
    "name": "Cancel a committed card",
    "values": {
      "0": {
        "name": "Off (no take-backs)",
        "description": "Clicking a hand card plays it immediately -- once committed, it's locked in for the round."
      },
      "1": {
        "name": "On",
        "description": "Clicking a card selects it; press Commit to actually play it. Once committed, you can still Cancel and take it back to hand until every player has committed."
      }
    },
    "default": 1
  }
}
