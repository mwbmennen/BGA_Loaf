{
  // option ids should be between 100 and 199
  // See https://en.doc.boardgamearena.com/Options_and_preferences:_gameoptions.json,_gamepreferences.json for more details

  "100": {
    "name": "Advanced round cards",
    "values": {
      "0": {
        "name": "Off (basic cards only)"
      },
      "1": {
        "name": "On",
        "description": "Adds the 12 advanced (croissant) round cards, with more elaborate effects. The rulebook recommends leaving this off for your first game.",
        "tmdisplay": "Advanced cards",
        "nobeginner": true
      }
    },
    "default": 0
  }
}
